{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sonad-reader",
  "main": "server/index.ts",
  "ai": { "binding": "AI" },
  "compatibility_date": "2026-09-09",
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": false }
}
